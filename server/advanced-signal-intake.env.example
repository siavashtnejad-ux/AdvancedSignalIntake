# Application is exposed by existing Nginx at http://85.198.17.18/signals/
EH_ROOT_PATH=/signals
EH_DB_PATH=/opt/advanced-signal-intake/data/ethical_horizon.db
EH_REQUEST_TIMEOUT=25
EH_DEFAULT_MAX_RESULTS=25
EH_MAX_RESULTS_CAP=100

# Recommended for PubMed identification; API key is optional.
NCBI_EMAIL=researcher@example.org
NCBI_API_KEY=

# OpenAlex requires an API key for normal API use.
OPENALEX_API_KEY=

# Recommended for Crossref polite usage.
CROSSREF_MAILTO=researcher@example.org
