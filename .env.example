# Optional but recommended for NCBI E-utilities identification:
NCBI_EMAIL=researcher@example.org
# Optional; increases allowed NCBI request rate:
NCBI_API_KEY=

# Required by OpenAlex for normal API usage as of 2026:
OPENALEX_API_KEY=

# Recommended "polite pool" identification for Crossref:
CROSSREF_MAILTO=researcher@example.org

# Optional application settings:
EH_REQUEST_TIMEOUT=25
EH_DEFAULT_MAX_RESULTS=25
EH_MAX_RESULTS_CAP=100
# EH_DB_PATH=/absolute/path/to/ethical_horizon.db
