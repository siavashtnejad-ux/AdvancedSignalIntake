# Public hostname pointing to this server, e.g. signal.example.com
DOMAIN=signal.example.com

# Email used by Caddy / Let's Encrypt for certificate notices
ACME_EMAIL=admin@example.com

# PubMed / NCBI identification (recommended)
NCBI_EMAIL=researcher@example.com
NCBI_API_KEY=

# OpenAlex requires an API key for normal API usage
OPENALEX_API_KEY=

# Crossref polite-pool identification (recommended)
CROSSREF_MAILTO=researcher@example.com

EH_REQUEST_TIMEOUT=25
EH_DEFAULT_MAX_RESULTS=25
EH_MAX_RESULTS_CAP=100
